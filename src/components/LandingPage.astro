---
import '../styles/global.css';
import { resolveMediaUrl, type LandingPage } from '../lib/strapi';

interface Props { content: LandingPage; preview?: boolean; strapiUrl?: string }
const { content, preview = false, strapiUrl = '' } = Astro.props;
const heroImage = resolveMediaUrl(content.hero.image, content.hero.imageFallbackUrl, strapiUrl);
const mailtoUrl = `mailto:${content.contact.email}?subject=${encodeURIComponent(content.contact.emailSubject)}`;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={content.seo.description} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>⚽</text></svg>" />
    <title>{content.seo.title}</title>
  </head>
  <body>
    {preview && <div class="preview-banner">Podgląd wersji roboczej — treść nie jest jeszcze opublikowana</div>}
    <header class="site-header">
      <a class="logo" href="#start" aria-label="Pierwszy Gwizdek — strona główna">
        <span class="logo-ball">⚽</span>
        <span>{content.navigation.brandPrefix} <strong>{content.navigation.brandAccent}</strong></span>
      </a>
      <nav aria-label="Główna nawigacja">
        {content.navigation.items.map((item) => <a href={item.target}>{item.label}</a>)}
      </nav>
      <a class="button button-small" href="#kontakt">{content.navigation.ctaLabel}</a>
      <button class="menu-button" aria-label="Otwórz menu" aria-expanded="false">☰</button>
    </header>

    <main>
      <section class="hero" id="start">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> {content.hero.eyebrow}</p>
          <h1>{content.hero.title}<br /><em>{content.hero.titleAccent}</em></h1>
          <p class="hero-lead">{content.hero.lead}</p>
          <div class="hero-actions">
            <a class="button" href="#kontakt">{content.hero.primaryCtaLabel} <span>→</span></a>
            <a class="text-link" href="#harmonogram">{content.hero.secondaryCtaLabel} ↓</a>
          </div>
          <div class="trust-row">
            <div class="avatars" aria-hidden="true"><span>👧</span><span>👦</span><span>🧒</span></div>
            <p><strong>{content.hero.trustTitle}</strong><br />{content.hero.trustText}</p>
          </div>
        </div>
        <div class="hero-art">
          <img
            src={heroImage}
            alt={content.hero.image?.alternativeText || content.hero.imageAlt}
            fetchpriority="high"
          />
          <div class="hero-shade"></div>
          <div class="hero-badge"><b>{content.hero.badgeValue}</b><span>{content.hero.badgeText}</span></div>
        </div>
      </section>

      <section class="intro" id="o-nas">
        <div>
          <p class="section-kicker">{content.intro.kicker}</p>
          <h2>{content.intro.heading}<br />{content.intro.headingSecondLine}</h2>
        </div>
        <p>{content.intro.text}</p>
      </section>

      <section class="benefits" aria-label="Nasze wartości">
        {content.benefits.map((item) => (
          <article>
            <div class={`benefit-icon benefit-${item.color}`}>{item.icon}</div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </section>

      <section class="schedule-section" id="harmonogram">
        <div class="section-heading centered">
          <p class="section-kicker">{content.schedule.kicker}</p>
          <h2>{content.schedule.heading}</h2>
          <p>{content.schedule.description}</p>
        </div>
        <div class="schedule-grid">
          {content.groups.map((group) => (
            <article class={`schedule-card ${group.color}`}>
              <div class="age">{group.age}</div>
              <h3>{group.name}</h3>
              <dl>
                <div><dt>Dni</dt><dd>{group.days}</dd></div>
                <div><dt>Godzina</dt><dd>{group.time}</dd></div>
              </dl>
              <a href="#kontakt">{content.schedule.cardCtaLabel} <span>→</span></a>
            </article>
          ))}
        </div>
        <p class="schedule-note">{content.schedule.note}</p>
      </section>

      <section class="location" id="miejsce">
        <div class="map-card">
          <div class="map-lines"></div><div class="map-river"></div>
          <div class="map-pin"><span>⚽</span></div>
          <span class="map-label">{content.location.mapLabel}</span>
        </div>
        <div class="location-copy">
          <p class="section-kicker">{content.location.kicker}</p>
          <h2>{content.location.heading}<br />{content.location.headingSecondLine}</h2>
          <p>{content.location.text}</p>
          <div class="address">
            <span>⌖</span>
            <div><strong>{content.location.place}</strong><br />{content.location.region}</div>
          </div>
          <a class="text-link dark" href={content.location.mapUrl} target="_blank" rel="noreferrer">{content.location.mapCtaLabel} →</a>
        </div>
      </section>

      <section class="cta" id="kontakt">
        <div class="cta-ball">⚽</div>
        <p class="section-kicker">{content.contact.kicker}</p>
        <h2>{content.contact.heading}</h2>
        <p>{content.contact.text}</p>
        <a class="button button-light" href={mailtoUrl}>{content.contact.buttonLabel} <span>→</span></a>
        <small>{content.contact.email}</small>
      </section>
    </main>

    <footer>
      <a class="logo footer-logo" href="#start"><span class="logo-ball">⚽</span><span>{content.navigation.brandPrefix} <strong>{content.navigation.brandAccent}</strong></span></a>
      <p>{content.footer.description}</p>
      <p>© {new Date().getFullYear()} {content.footer.copyrightName}</p>
    </footer>

    <script>
      const button = document.querySelector('.menu-button');
      const nav = document.querySelector('nav');
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') === 'true';
        button.setAttribute('aria-expanded', String(!open));
        nav?.classList.toggle('open');
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        nav.classList.remove('open');
        button?.setAttribute('aria-expanded', 'false');
      }));
    </script>
  </body>
</html>
