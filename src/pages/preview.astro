---
export const prerender = false;
import LandingPage from '../components/LandingPage.astro';
import { getLandingPage } from '../lib/strapi';

const suppliedSecret = Astro.url.searchParams.get('secret') || '';
const expectedSecret = import.meta.env.PREVIEW_SECRET || '';
const status = Astro.url.searchParams.get('status');

if (!expectedSecret || suppliedSecret !== expectedSecret) {
  return new Response('Nieprawidłowy lub brakujący token podglądu.', { status: 401 });
}

if (status !== 'draft' && status !== 'published') {
  return new Response('Nieprawidłowy status podglądu.', { status: 400 });
}

const content = await getLandingPage(status);
Astro.response.headers.set('Cache-Control', 'private, no-store, max-age=0');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<LandingPage content={content} preview={status === 'draft'} />
